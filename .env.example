# Copy to `.env.local` and adjust. `.env.local` is gitignored.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle and is
# therefore public. Never put a secret behind that prefix.
#
# These are validated at startup by src/config/env.ts — a malformed value fails
# the build rather than surfacing as `undefined` at runtime.

# Canonical origin of the site. Used for metadata and OG image URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL the axios client points at.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
